<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxWidth="1.7976931348623157E308"
         spacing="10.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="1.7976931348623157E308"
               minHeight="-Infinity" styleClass="dialog" wrapText="true" HBox.hgrow="ALWAYS" />
        <Label fx:id="avatar" alignment="CENTER" minHeight="52.0"
               minWidth="52.0" styleClass="avatar" />
    </children>
    <padding>
        <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
    </padding>
</fx:root>
